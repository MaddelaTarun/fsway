#!/bin/sh
# prime-run — run a command on the discrete NVIDIA GPU from an Intel-displayed session
# (PRIME render offload; mirror of Arch's prime-run for the NVIDIA proprietary driver)
export __NV_PRIME_RENDER_OFFLOAD=1
export __NV_PRIME_RENDER_OFFLOAD_PROVIDER=NVIDIA-G0
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export __VK_LAYER_NV_optimus=NVIDIA_only
exec "$@"